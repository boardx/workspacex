{
  "name": "@repo/desktop",
  "productName": "WorkspaceX Local",
  "version": "0.1.0",
  "private": true,
  "description": "WorkspaceX Local 桌面外壳（issue #3716 / PROP-LOCAL-WORKSPACE-001）：Electron 主进程 = 服务监督器 + 硬件自检 + 主窗口；渲染层就是 apps/web，不另写 UI。编排逻辑全部在 @repo/local-runtime，本包只负责窗口、托盘与打包。",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:electron --external:@electric-sql/pglite --external:@electric-sql/pglite-pgvector --external:@electric-sql/pglite-socket --outfile=dist/main.cjs",
    "dev": "pnpm run build:main && electron .",
    "dist:mac": "pnpm run build:main && electron-builder --mac --config electron-builder.yml",
    "dist:win": "pnpm run build:main && electron-builder --win --config electron-builder.yml",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: ok'",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@electric-sql/pglite-socket": "0.2.11",
    "@repo/local-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "*",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "typescript": "*",
    "vitest": "^2.0.0"
  }
}
