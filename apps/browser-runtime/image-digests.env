# Reviewed, immutable image digests for the controlled browser runtime — the SINGLE source
# of these values. Do not restate them in README.md, compose, or a workflow: this project has
# been bitten five times by the same fact living in two places. README.md links here instead.
#
# Both digests were resolved and reviewed on 2026-09-07 and are verifiable against the
# registries without pulling:
#   curl -sSI -H 'Accept: application/vnd.oci.image.index.v1+json' \
#     https://mcr.microsoft.com/v2/playwright/mcp/manifests/sha256:<BROWSER_RUNTIME_IMAGE_DIGEST>
#
# BROWSER_RUNTIME_IMAGE_DIGEST is the official Playwright MCP image matching @playwright/mcp@0.0.80.
BROWSER_RUNTIME_IMAGE_DIGEST=dda1f7f9b812e22946635c8af7df9288b96d3b9e3f0f1b8576d6823e2031c1de
# BROWSER_EGRESS_PROXY_IMAGE_DIGEST is ubuntu/squid 6.6-24.04_beta, the only public-network peer.
BROWSER_EGRESS_PROXY_IMAGE_DIGEST=6a097f68bae708cedbabd6188d68c7e2e7a38cedd05a176e1cc0ba29e3bbe029
# Chromium runs unprivileged with --sandbox. Never relax this to run the browser as root.
BROWSER_UID=1000
BROWSER_GID=1000
