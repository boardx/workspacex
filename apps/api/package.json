    "test:file-cloud-db": "vitest run --config vitest.file-cloud-db.config.ts",
    "test:inbox-unit": "vitest run --config vitest.inbox-unit.config.ts",
    "test:native-output-unit": "vitest run --config vitest.native-output-unit.config.ts",
    "test:workbench-unit": "vitest run --config vitest.workbench-unit.config.ts",
    "test:audio-real-model": "vitest run --config vitest.audio-real-model.config.ts",
    "test:authoring-skill-real-model": "vitest run --config vitest.authoring-skill-real-model.config.ts",
    "test:canvas-skill-real-model": "vitest run --config vitest.canvas-skill-real-model.config.ts",
    "test:document-skill-real-model": "vitest run --config vitest.document-skill-real-model.config.ts",
    "test:document-skills-real-model": "vitest run --config vitest.document-skills-real-model.config.ts",
    "test:extended-skills-real-model": "vitest run --config vitest.extended-skills-real-model.config.ts",
    "test:generated-skill-real-model": "vitest run --config vitest.generated-skill-real-model.config.ts",
    "test:methods-real-model": "vitest run --config vitest.methods-real-model.config.ts",
    "test:remaining-skills-real-model": "vitest run --config vitest.remaining-skills-real-model.config.ts",
    "test:skill-batch-real-model": "vitest run --config vitest.skill-batch-real-model.config.ts",
