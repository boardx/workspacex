{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-error-leak.mjs && node scripts/lint-permission-paths.mjs && node scripts/lint-no-builtin-capabilities.mjs && node scripts/lint-design-facet-single-source.mjs && tsx scripts/gen-design-facet-catalog.ts --check && tsx scripts/gen-agenda-tier-catalog.ts --check &&node scripts/lint-skill-context-api-only.mjs && node scripts/lint-naming-single-source.mjs && node ../../.harness/scripts/lint-arch-deps.mjs apps/api/src",
    "test": "vitest run && vitest run --config vitest.exclusive.config.ts",
    "test:stability": "bash scripts/verify-test-stability.sh",
    "test:stability:tempfile": "bash scripts/verify-test-stability.sh --check-tempfiles",
    "migrate": "tsx src/infrastructure/db/migrate-cli.ts",
    "migrate:check": "./scripts/verify-migrations.sh",
    "dev:deps": "docker compose -f docker-compose.dev.yml -p workspacex-kernel up -d"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.57",
    "@firecrawl/anydoc": "0.1.8",
    "@langchain/core": "0.3.80",
    "@langchain/langgraph": "0.4.9",
    "@langchain/langgraph-checkpoint-postgres": "0.1.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@repo/contracts": "workspace:*",
    "bcryptjs": "^3.0.2",
    "ioredis": "^5.4.1",
    "multer": "2.2.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "7.28.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@repo/fabric-markdown": "workspace:*",
    "@repo/skill-sandbox": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "fabric": "7.4.0",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
