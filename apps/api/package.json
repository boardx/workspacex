    "debug:trace": "tsx scripts/debug-trace-cli.ts",
    "dev:deps": "docker compose -f docker-compose.dev.yml -p workspacex-kernel up -d",
    "gen:native-profile-tools": "tsx scripts/generate-native-profile-tools.ts",
    "files:purge": "node --import tsx scripts/run-physical-deletion.ts",
    "board:migrate-content": "tsx scripts/migrate-board-content.ts",
    "board:gc-content": "tsx scripts/sweep-board-blobs.ts",
