# Server-side billing only. Copy values into your ignored .env.local (development)
# or the API service's protected runtime environment (deployment), never the web bundle.
# Existing reference STRIPE_RETURN_LINK is supported; canonical STRIPE_RETURN_URL wins.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK=
STRIPE_RETURN_URL=https://devapp.boardx.us/billing?subscription_return=1
# Portal sessions are created by the server; STRIPE_MANAGEMENT_PORTAL is optional.
# Register this separate Stripe webhook endpoint and use ITS signing secret above:
# https://devapp.boardx.us/api/billing/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed.
# Configure the Payment Link completion redirect to the same STRIPE_RETURN_URL.
# For local Stripe CLI forwarding use its printed whsec signing secret, and a
# loopback STRIPE_RETURN_URL, e.g. http://localhost:3000/billing?subscription_return=1.

WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
# Alternatively set WECHAT_PAY_PRIVATE_KEY to the merchant private PEM.
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
# Public-key mode requires its matching PUB_KEY_ID_...; a platform certificate
# can be supplied instead, in which case its serial is derived and validated.
WECHAT_PAY_PLATFORM_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://devapp.boardx.us/api/billing/webhooks/wechat
# Never substitute the merchant key for the WeChat platform verification key.
