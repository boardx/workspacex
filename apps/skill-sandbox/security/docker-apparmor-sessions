# Dedicated sessions-container policy; never replaces docker-default globally.
# Baseline: moby/moby v28.0.0 profiles/apparmor/template.go (Apache-2.0).
# Rendered name/imports/daemon peer below. Default proc/sys/ptrace restrictions retained.
# Setup exceptions: userns, mount and pivot_root for trusted bubblewrap. The mandatory
# --seccomp FD BPF installed before user code denies these operations irrevocably.
#include <tunables/global>
profile workspacex-native-sessions flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  umount,
  userns,
  mount,
  pivot_root,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=workspacex-native-sessions,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  ptrace (trace,read,tracedby,readby) peer=workspacex-native-sessions,
}
