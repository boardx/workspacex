    "e2e:kg-experience:score": "node e2e/kg-experience-eval/score.mjs",
    "ci:board:journeys": "node scripts/run-board-ci-lane.mjs journeys -- pnpm --filter web exec playwright test --config e2e/board-journey-acceptance.config.ts",
