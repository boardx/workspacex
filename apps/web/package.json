    "ci:board:storage": "node scripts/run-board-ci-lane.mjs storage -- pnpm --filter web exec playwright test --config playwright.board-storage-ci.config.ts",
    "ci:board:performance": "node scripts/run-board-ci-lane.mjs performance -- pnpm --filter web exec playwright test --config e2e/board-performance-acceptance.config.ts",
    "ci:board:collaboration-50": "node scripts/run-board-ci-lane.mjs collaboration-50 -- pnpm --filter web exec playwright test --config playwright.board-soak-acceptance.config.ts",
    "ci:board:meeting-room": "node scripts/run-board-ci-lane.mjs meeting-room -- pnpm --filter web exec playwright test --config playwright.board-meeting-room-acceptance.config.ts"
