{
  "toolName": "wx_document_parse",
  "limits": {
    "timeoutMs": 30000,
    "responseBytes": 32768
  },
  "ocrLimits": {
    "maxPages": 10,
    "maxPixels": 4194304,
    "maxDimension": 2048,
    "maxOutputBytes": 8388608
  },
  "structure": {
    "type": "object",
    "properties": {
      "engine": {
        "type": "string",
        "const": "tesseract"
      },
      "coordinateSpace": {
        "type": "string",
        "const": "rendered_page_pixels"
      },
      "pages": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "pageNumber": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "width": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048,
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048,
              "exclusiveMinimum": 0
            },
            "words": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bbox": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2048
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2048
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2048
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2048
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "text",
                  "bbox",
                  "confidence"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "pageNumber",
            "width",
            "height",
            "words"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 10
      }
    },
    "required": [
      "engine",
      "coordinateSpace",
      "pages"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "toolInput": {
    "type": "object",
    "properties": {
      "workspacePath": {
        "type": "string",
        "pattern": "^\\/inputs\\/",
        "maxLength": 4096
      },
      "outputMode": {
        "type": "string",
        "const": "markdown"
      },
      "ocr": {
        "type": "boolean"
      }
    },
    "required": [
      "workspacePath"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "input": {
    "type": "object",
    "properties": {
      "orgId": {
        "type": "string",
        "minLength": 1
      },
      "attemptId": {
        "type": "string",
        "minLength": 1
      },
      "leaseEpoch": {
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "bindingId": {
        "type": "string",
        "format": "uuid"
      },
      "toolCallId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "permissionRequestId": {
        "type": "string",
        "format": "uuid"
      },
      "toolName": {
        "type": "string",
        "const": "wx_document_parse"
      },
      "toolArgs": {
        "type": "object",
        "properties": {
          "workspacePath": {
            "type": "string",
            "pattern": "^\\/inputs\\/",
            "maxLength": 4096
          },
          "outputMode": {
            "type": "string",
            "const": "markdown"
          },
          "ocr": {
            "type": "boolean"
          }
        },
        "required": [
          "workspacePath"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "orgId",
      "attemptId",
      "leaseEpoch",
      "bindingId",
      "toolCallId",
      "toolName",
      "toolArgs"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "output": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "textPath": {
            "type": "string",
            "pattern": "^\\/workspace\\/parsed-[a-f0-9-]{36}\\/document\\.md$"
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "textHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "object",
            "properties": {
              "attachmentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "path": {
                "type": "string",
                "maxLength": 4096
              },
              "mediaType": {
                "type": "string",
                "maxLength": 256
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "attachmentId",
              "path",
              "mediaType",
              "sizeBytes"
            ],
            "additionalProperties": false
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "markdown_only_no_page_coordinates",
                "ocr_not_performed",
                "tables_may_lose_layout",
                "ocr_may_misrecognize_text"
              ]
            },
            "maxItems": 4
          }
        },
        "required": [
          "textPath",
          "sourceHash",
          "textHash",
          "source",
          "warnings"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "textPath": {
            "type": "string",
            "pattern": "^\\/workspace\\/parsed-[a-f0-9-]{36}\\/document\\.md$"
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "textHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "object",
            "properties": {
              "attachmentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "path": {
                "type": "string",
                "maxLength": 4096
              },
              "mediaType": {
                "type": "string",
                "maxLength": 256
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "attachmentId",
              "path",
              "mediaType",
              "sizeBytes"
            ],
            "additionalProperties": false
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "markdown_only_no_page_coordinates",
                "ocr_not_performed",
                "tables_may_lose_layout",
                "ocr_may_misrecognize_text"
              ]
            },
            "maxItems": 4
          },
          "structurePath": {
            "type": "string",
            "pattern": "^\\/workspace\\/parsed-[a-f0-9-]{36}\\/structure\\.json$"
          },
          "structureHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "textPath",
          "sourceHash",
          "textHash",
          "source",
          "warnings",
          "structurePath",
          "structureHash"
        ],
        "additionalProperties": false
      }
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}
