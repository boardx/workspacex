{
  "toolName": "wx_audio_transcribe",
  "limits": {
    "maxBytes": 8388608,
    "maxDurationMs": 3600000,
    "chunkDurationMs": 30000,
    "deadlineMs": 240000,
    "concurrency": 4,
    "decodeDeadlineMs": 120000,
    "maxTextBytes": 262144,
    "responseBytes": 270336
  },
  "toolInput": {
    "type": "object",
    "properties": {
      "attachmentId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "language": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "diarization": {
        "type": "boolean"
      }
    },
    "required": [
      "attachmentId"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "input": {
    "type": "object",
    "properties": {
      "orgId": {
        "type": "string",
        "minLength": 1
      },
      "attemptId": {
        "type": "string",
        "minLength": 1
      },
      "leaseEpoch": {
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "bindingId": {
        "type": "string",
        "format": "uuid"
      },
      "toolCallId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "permissionRequestId": {
        "type": "string",
        "format": "uuid"
      },
      "toolName": {
        "type": "string",
        "const": "wx_audio_transcribe"
      },
      "toolArgs": {
        "type": "object",
        "properties": {
          "attachmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "diarization": {
            "type": "boolean"
          }
        },
        "required": [
          "attachmentId"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "orgId",
      "attemptId",
      "leaseEpoch",
      "bindingId",
      "toolCallId",
      "toolName",
      "toolArgs"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "output": {
    "type": "object",
    "properties": {
      "workspacePath": {
        "type": "string",
        "pattern": "^\\/workspace\\/transcribed-[a-f0-9]{64}\\.json$"
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "sourceHash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "segments": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "startMs": {
              "type": "integer",
              "minimum": 0
            },
            "endMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 3600000
            },
            "text": {
              "type": "string",
              "maxLength": 262144
            }
          },
          "required": [
            "id",
            "startMs",
            "endMs",
            "text"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 120
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "source_chunk_boundaries_not_word_timestamps",
            "speaker_identity_unavailable",
            "confidence_not_calibrated",
            "no_recognized_speech",
            "some_chunks_without_recognized_speech"
          ]
        },
        "maxItems": 5
      }
    },
    "required": [
      "workspacePath",
      "sha256",
      "sourceHash",
      "segments",
      "warnings"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}
