{
  "manifest": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "attachmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "path": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^\\/inputs\\/[a-f0-9]{64}\\/[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "attachmentId",
        "filename",
        "path",
        "mediaType",
        "sizeBytes",
        "digest"
      ],
      "additionalProperties": false
    },
    "maxItems": 256,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "input": {
    "type": "object",
    "properties": {
      "orgId": {
        "type": "string",
        "minLength": 1
      },
      "attemptId": {
        "type": "string",
        "minLength": 1
      },
      "leaseEpoch": {
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "toolName": {
        "type": "string",
        "const": "read_file"
      },
      "skillStableName": {
        "type": "string",
        "minLength": 1
      },
      "permissionRequestId": {
        "type": "string",
        "format": "uuid"
      },
      "toolCallId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "toolArgs": {
        "type": "object",
        "additionalProperties": {}
      },
      "file": {
        "type": "object",
        "properties": {
          "attachmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "path": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^\\/inputs\\/[a-f0-9]{64}\\/[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "attachmentId",
          "filename",
          "path",
          "mediaType",
          "sizeBytes",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "orgId",
      "attemptId",
      "leaseEpoch",
      "toolName",
      "toolCallId",
      "toolArgs",
      "file"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "output": {
    "type": "object",
    "properties": {
      "allowed": {
        "type": "boolean",
        "const": true
      }
    },
    "required": [
      "allowed"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}
