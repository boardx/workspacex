{
  "limits": {
    "maxCandidates": 100,
    "maxTextBytes": 32768,
    "maxRequestBytes": 1048576,
    "maxResponseBytes": 1048576,
    "deadlineMs": 30000
  },
  "input": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "content": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "content"
          ],
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "accounting": {
        "type": "object",
        "properties": {
          "orgId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "attemptId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "leaseEpoch": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "orgId",
          "runId",
          "attemptId",
          "leaseEpoch"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "query",
      "candidates"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "output": {
    "type": "object",
    "properties": {
      "model": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "modelVersion": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "maxItems": 100
      }
    },
    "required": [
      "model",
      "modelVersion",
      "ids"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}
