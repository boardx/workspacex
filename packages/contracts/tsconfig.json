{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "esnext",
    "moduleResolution": "bundler", "strict": true, "noUncheckedIndexedAccess": true,
    "noEmit": true, "esModuleInterop": true, "skipLibCheck": true, "isolatedModules": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
