        "html": "<style>\n.page {\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  background-color: #F8F5F0;\n  font-family: ui-rounded, -apple-system, 'PingFang SC', 'Noto Sans SC', sans-serif;\n  color: #3A3632;\n  padding: 0 24px;\n  box-sizing: border-box;\n}\n\n.top-bar {\n  padding-top: 64px;\n  padding-bottom: 48px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.back-btn {\n  width: 40px;\n  height: 40px;\n  border-radius: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  -webkit-tap-highlight-color: transparent;\n}\n\n.back-btn:active {\n  background-color: rgba(212, 226, 212, 0.3);\n}\n\n.top-title {\n  font-size: 17px;\n  font-weight: 500;\n  line-height: 1.5;\n}\n\n.top-placeholder {\n  width: 40px;\n}\n\n.mood-section {\n  margin-bottom: 48px;\n}\n\n.section-label {\n  font-size: 13px;\n  font-weight: 400;\n  color: #A8A29E;\n  line-height: 1.5;\n  margin-bottom: 20px;\n}\n\n.mood-options {\n  display: flex;\n  gap: 16px;\n}\n\n.mood-item {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  cursor: pointer;\n  -webkit-tap-highlight-color: transparent;\n}\n\n.mood-shape-wrap {\n  width: 56px;\n  height: 56px;\n  border-radius: 28px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.mood-item.selected .mood-shape-wrap {\n  background-color: #D4E2D4;\n}\n\n.mood-name {\n  font-size: 13px;\n  font-weight: 400;\n  color: #A8A29E;\n  line-height: 1.5;\n}\n\n.mood-item.selected .mood-name {\n  color: #3A3632;\n  font-weight: 500;\n}\n\n.text-section {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  margin-bottom: 32px;\n}\n\n.diary-input {\n  flex: 1;\n  min-height: 160px;\n  width: 100%;\n  box-sizing: border-box;\n  background: transparent;\n  border: none;\n  outline: none;\n  resize: none;\n  font-family: inherit;\n  font-size: 15px;\n  font-weight: 400;\n  line-height: 1.7;\n  color: #3A3632;\n  padding: 0;\n}\n\n.diary-input::placeholder {\n  color: #A8A29E;\n}\n\n.footer-action {\n  padding-bottom: 40px;\n  padding-top: 16px;\n  margin-top: auto;\n}\n\n.btn-save {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  height: 52px;\n  border-radius: 26px;\n  background-color: #6B8E73;\n  color: #F8F5F0;\n  font-size: 17px;\n  font-weight: 500;\n  cursor: pointer;\n  border: none;\n  outline: none;\n  -webkit-tap-highlight-color: transparent;\n}\n\n.btn-save:active {\n  background-color: #5A7A62;\n}\n\n.btn-save.disabled {\n  background-color: #D4E2D4;\n  color: #A8A29E;\n  cursor: default;\n}\n\n.btn-save.disabled:active {\n  background-color: #D4E2D4;\n}\n</style>\n<div class=\"page\" data-ref=\"r1\">\n  <div class=\"top-bar\" data-ref=\"r2\">\n    <div class=\"back-btn\" data-link=\"goto-0-0\" data-goto=\"0\" data-ref=\"r3\">\n      <svg width=\"20\" height=\"20\" viewbox=\"0 0 20 20\" fill=\"none\" data-ref=\"r4\">\n        <path d=\"M12.5 15L7.5 10L12.5 5\" stroke=\"#3A3632\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n      </svg>\n    </div>\n    <span class=\"top-title\" data-ref=\"r5\">写日记</span>\n    <div class=\"top-placeholder\" data-ref=\"r6\"></div>\n  </div>\n\n  <div class=\"mood-section\" data-ref=\"r7\">\n    <div class=\"section-label\" data-ref=\"r8\">现在的感觉</div>\n    <div class=\"mood-options\" data-ref=\"r9\">\n      <div class=\"mood-item selected\" data-ref=\"r10\">\n        <div class=\"mood-shape-wrap\" data-ref=\"r11\">\n          <svg width=\"28\" height=\"28\" viewbox=\"0 0 28 28\" fill=\"none\" data-ref=\"r12\">\n            <circle cx=\"14\" cy=\"14\" r=\"11\" fill=\"#6B8E73\" />\n          </svg>\n        </div>\n        <span class=\"mood-name\" data-ref=\"r13\">平静</span>\n      </div>\n      <div class=\"mood-item\" data-ref=\"r14\">\n        <div class=\"mood-shape-wrap\" data-ref=\"r15\">\n          <svg width=\"28\" height=\"28\" viewbox=\"0 0 28 28\" fill=\"none\" data-ref=\"r16\">\n            <rect x=\"5\" y=\"5\" width=\"18\" height=\"18\" rx=\"7\" fill=\"#A8A29E\" />\n          </svg>\n        </div>\n        <span class=\"mood-name\" data-ref=\"r17\">开心</span>\n      </div>\n      <div class=\"mood-item\" data-ref=\"r18\">\n        <div class=\"mood-shape-wrap\" data-ref=\"r19\">\n          <svg width=\"28\" height=\"28\" viewbox=\"0 0 28 28\" fill=\"none\" data-ref=\"r20\">\n            <ellipse cx=\"14\" cy=\"14\" rx=\"12\" ry=\"8\" fill=\"#A8A29E\" />\n          </svg>\n        </div>\n        <span class=\"mood-name\" data-ref=\"r21\">低落</span>\n      </div>\n      <div class=\"mood-item\" data-ref=\"r22\">\n        <div class=\"mood-shape-wrap\" data-ref=\"r23\">\n          <svg width=\"28\" height=\"28\" viewbox=\"0 0 28 28\" fill=\"none\" data-ref=\"r24\">\n            <rect x=\"7\" y=\"7\" width=\"14\" height=\"14\" rx=\"3\" fill=\"#A8A29E\" />\n          </svg>\n        </div>\n        <span class=\"mood-name\" data-ref=\"r25\">烦躁</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"text-section\" data-ref=\"r26\">\n    <div class=\"section-label\" data-ref=\"r27\">想说的话</div>\n    <textarea class=\"diary-input\" placeholder=\"今天发生了什么，随便写几句…\" data-ref=\"r28\"></textarea>\n  </div>\n\n  <div class=\"footer-action\" data-ref=\"r29\">\n    <button class=\"btn-save\" data-ref=\"r30\">保存今天的心情</button>\n  </div>\n</div>"
