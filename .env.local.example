# .env.local.example —— 真实模型 e2e 通道（issue #2802）需要的变量清单。
#
# 复制成仓库根的 .env.local（chmod 600，已被 .gitignore 挡住），填上真值即可。
# 换个路径：export WORKSPACEX_ENV_FILE=/abs/path/to/.env.local
#
# ⚠ 这个文件里**不许**出现任何真值。它是清单，不是凭据。

# ── ① 真实模型上游（e2e-up.sh 起全栈时必需）───────────────────────────────
# 缺任何一个，e2e-up.sh 会逐个点名后红退，不会退回回环模型。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=

# ── ② 真实模型 spec 的登录账号（本地栈：用种子里的账号即可）──────────────
# 本地一条命令 `pnpm run e2e:real-model-smoke` 会自动填成 fullstack 种子里的
# 引导师账号，所以本地通常**不用**填这两行。填了就以填的为准（比如你想用
# devapp 上的真实账号跑同一条 spec）。
# REAL_MODEL_E2E_EMAIL=
# REAL_MODEL_E2E_PASSWORD=

# ── ③ 可选：与线上同款的 deep-agent 内核 ─────────────────────────────────
# devapp 上是 127.0.0.1:2025（deploy.sh 第 4h 步起的容器）。本机没跑这个服务就
# 别填——填一个连不上的地址只会让 run 以 MODEL_PROVIDER_NOT_CONFIGURED 失败。
# 不填时这条 spec 仍然跑真实模型 + 真实技能沙箱，只是不经 deep-agent 内核，
# 证据包 00-context.json 会如实记下这次走的是哪条。
# KERNEL_DEEP_AGENT_BASE_URL=http://127.0.0.1:2025

# ── ④ 可选：调参 ─────────────────────────────────────────────────────────
# REAL_MODEL_E2E_PROMPT=生成一个 pdf，总结你可以做的事情
# REAL_MODEL_E2E_RUN_TIMEOUT_MS=900000
