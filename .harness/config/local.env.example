# local.env.example —— CI/CD 落到自建 VM 所需的配置参数清单
#
# 用法：`cp .harness/config/local.env.example .harness/config/local.env`，填空。
# `local.env` 已进 .gitignore，**永远不提交**。
#
# ──────────────────────────────────────────────────────────────────────────────
# ⚠ 这个文件里不放密码。一个都不放。
#
# 它放的是**非机密的形态与坐标**：主机、端口、路径、并发度、策略开关。
# 真正的机密（DB 密码 / S3 密钥 / 模型网关 key / registry token）放两个地方：
#   · GitHub Actions → 仓库 Settings → Secrets and variables → Actions
#   · VM 上 → runner 服务的 environment file（0600，属 runner 用户）
# 本文件只负责**点名有哪些机密必须存在、叫什么名字**（见 F 节），
# 这样「缺了哪个」在配置阶段就能发现，而不是在部署到一半时。
#
# 判据很简单：这个文件泄漏出去，攻击者应当只知道我们的**部署形态**，
# 不应当因此能连上任何东西。
# ──────────────────────────────────────────────────────────────────────────────
#
# 标记：
#   [必填]  —— 你必须给我，我推导不出来
#   [确认]  —— 我已填了推导值，你核对一下对不对
#   [可选]  —— 有默认值，不填也能跑

# =============================================================================
# A. VM 与 runner 接入                                              [必填]
# =============================================================================
# 我打算用 **GitHub Actions self-hosted runner**，理由：仓库已在 GitHub，
# issue/PR 投影也已经跑起来了，再引第二套 CI 系统会让「哪次跑挂了」有两个答案。
# 如果你想用别的（Jenkins / Gitea Actions / 裸 systemd timer），在这里说明，
# 下面 A/B 两节的形状会跟着变。

VM_HOST=                      # [必填] IP 或域名
VM_SSH_PORT=22                # [可选]
VM_SSH_USER=                  # [必填] 我用它装 runner；建议**不是 root**
VM_SSH_KEY_PATH=              # [必填] 本机私钥路径（文件本身不进仓库）

VM_OS=                        # [必填] 如 ubuntu-24.04
VM_ARCH=                      # [必填] x86_64 | aarch64 —— 决定 runner 与镜像的架构
VM_CPU_CORES=                 # [必填] 决定下面的 CI_MAX_PARALLEL_JOBS
VM_MEM_GB=                    # [必填] 每个并行 job 要起一套 PG，内存是真的会不够
VM_DISK_GB=                   # [必填] 镜像 + PG 数据 + artifact 都在这

RUNNER_WORKDIR=/opt/actions-runner   # [可选]
RUNNER_LABELS=self-hosted,linux,workspacex  # [可选] workflow 里用它选 runner
RUNNER_SERVICE_USER=          # [确认] 默认同 VM_SSH_USER；**不要用 root 跑 runner**
                              # —— runner 执行的是 PR 里的代码，root 意味着任何人
                              #    提个 PR 就能拿到这台机器

# =============================================================================
# B. 并发度                                                          [确认]
# =============================================================================
# ⚠ 这一节不是调参，是**刚刚才修好的东西的配置面**。
#
# 后端门控要真数据库：`verify-rls.sh` 会 DROP DATABASE。两个 job 同时跑而共用一个库名，
# 一个会在另一个测到一半时把库删掉——症状不是干净的失败，是**断言随执行顺序时红时绿**。
# 已经修好的机制：每个 worker 用自己的库（WORKSPACEX_DB）+ 按 worker 派生测试端口。
# 反证跑过：两个全新库并行各跑全套，12 文件 / 209 测试双双全绿。
#
# 所以这里填的数字直接决定同时存在几个数据库。

CI_MAX_PARALLEL_JOBS=2        # [确认] 建议 ≤ (VM_CPU_CORES / 2)，且 ≥ 2GB 内存/job
CI_DB_PREFIX=wsx_ci           # [可选] 每个 job 的库名 = ${CI_DB_PREFIX}_${运行号}
CI_DB_GC_HOURS=24             # [可选] 超过这个时长的残留库自动清掉
                              # —— job 被取消时不会走到清理步骤，不回收会撑爆磁盘

# =============================================================================
# C. 容器运行时与镜像仓库
# =============================================================================
DOCKER_ROOTLESS=false         # [确认] rootless 更安全但 compose 的端口映射会有坑；
                              #        选 true 我把 PG 端口改成 >1024 的（现在是 55432，已经是）
CONTAINER_REGISTRY=ghcr.io    # [可选] ghcr.io | docker.io | 自建 harbor 地址
REGISTRY_NAMESPACE=boardx     # [确认] 镜像名 = ${CONTAINER_REGISTRY}/${REGISTRY_NAMESPACE}/workspacex-api
REGISTRY_USERNAME=            # [必填] token 本身进 GitHub Secrets（见 F 节）

# =============================================================================
# D. CI 里的依赖服务
# =============================================================================
# 端口刻意都不是默认值，避免和 VM 上已有的服务撞。
CI_PG_PORT=55432              # [可选] 与本地开发一致，`docker-compose.dev.yml` 已在用
CI_MINIO_PORT=59000           # [可选]
CI_REDIS_PORT=56379           # [可选]
CI_PG_IMAGE=pgvector/pgvector:pg16   # [确认] 必须带 pgvector：F10 的混合召回依赖它，
                                     #        后补扩展意味着第二个基础镜像 + 第二套迁移

# ⚠ 前端 e2e 要下 Playwright 浏览器（约 400MB）。装在镜像里还是每次下？
CI_PLAYWRIGHT_CACHE=/opt/ms-playwright  # [可选] 留空 = 每次下载（慢但干净）

# =============================================================================
# E. 部署目标（CD 部分）
# =============================================================================
# `architecture.md` 已定三条硬规则，这里的参数是它们的落点：
#   ① 有 CD 的目标**不手动部署**
#   ② **迁移先于部署且幂等**（`migrate:check` 已经在证这条）
#   ③ 冒烟带漂移探针

DEPLOY_ENABLED=false          # [必填] 先只要 CI 就填 false，我不会生成 CD 部分
DEPLOY_ENVIRONMENTS=staging   # [必填] 逗号分隔，如 staging,prod
DEPLOY_TARGET_HOST=           # [必填当 DEPLOY_ENABLED=true] 可以就是 VM_HOST
DEPLOY_PATH=/srv/workspacex   # [可选]
DEPLOY_STRATEGY=compose       # [确认] compose | k8s —— 单机私有形态用 compose
                              #        （architecture.md 部署三形态之一）

APP_API_PORT=3200             # [可选] 与 apps/api 默认一致
APP_WEB_PORT=3100             # [可选]
PUBLIC_DOMAIN=                # [必填当 DEPLOY_ENABLED=true] 如 workspacex.example.com
TLS_PROVIDER=caddy            # [确认] architecture.md 指定 Caddy 做 TLS 终结
                              #        —— 填 none 则我假设你前面有别的反代

# 生产库**不是** CI 库。写在这里是为了让「它们是两个东西」显式可见——
# 把 CI 的 DROP DATABASE 指到生产是最容易犯且最不可逆的一次错。
PROD_PG_HOST=                 # [必填当 DEPLOY_ENABLED=true]
PROD_PG_PORT=5432
PROD_PG_DATABASE=workspacex
PROD_APP_DB_USER=app_rw       # [确认] **非表 owner、无 BYPASSRLS、无 DDL**
PROD_MIGRATION_DB_USER=       # [必填当 DEPLOY_ENABLED=true] owner 身份，**只在迁移时用**
                              # ⚠ 两个身份必须分开。PG 里表 owner 默认不受 RLS 约束，
                              #    合成一个连接串 = RLS 写了但没生效，且表面一切正常。
                              #    这是「以为开了 RLS 其实没开」的头号成因（F18 I-4）。

# =============================================================================
# F. 机密清单 —— 值不在这里，**名字在这里**
# =============================================================================
# 下面每一行是一个必须存在的 secret。缺哪个，配置阶段就报，不要等部署到一半。
# 位置：GitHub → Settings → Secrets and variables → Actions
#
#   REGISTRY_TOKEN            推镜像
#   PROD_APP_DB_PASSWORD      运行时应用身份
#   PROD_MIGRATION_DB_PASSWORD 迁移 owner 身份
#   S3_ACCESS_KEY_ID          对象存储（原件不可变，architecture.md 不变量）
#   S3_SECRET_ACCESS_KEY
#   MODEL_GATEWAY_API_KEY     模型网关；本地组织路径**不得使用**（见 G 节）
#
# ⚠ CI 日志里 secret 会被 GitHub 自动打码，但**只对完全匹配**有效。
#   拼接过、base64 过、截断过的都不会被打码。别在脚本里对 secret 做变换后 echo。
SECRETS_CONFIGURED=false      # [必填] 你在 GitHub 里都建好了就改成 true，我据此决定是否生成 CD

# =============================================================================
# G. 出网策略（X-3）—— 这一条是架构约束，不是运维偏好
# =============================================================================
# phase-00 一致性复核原话：「这条如果没人认领，它会在前后端与运维的缝里掉下去」。
# 2026-07-28 签核时它**带着「无人认领」的缺口过去了**；F18 签核时才定下分工：
#   · 落点（网络策略块 + 部署清单）归 api-kernel —— 已交付
#   · deny-all 的**断言**归 F16（本地组织完整形态）—— 未做
#
# ⚠ 断言必须在**网络层**观测。应用层只能证明「我没主动发起出网」，
#   证明不了「没有任何出网」——第三方 SDK、遥测、依赖库都会出网。

EGRESS_POLICY=allowlist       # [确认] allowlist | open。本地组织路径将来必须是 deny-all
EGRESS_ALLOWLIST=             # [必填当 EGRESS_POLICY=allowlist] 逗号分隔域名
                              # 我推导出的最小集（请核对，多一个都是一个出网面）：
                              #   registry.npmjs.org        pnpm 安装
                              #   github.com,api.github.com  checkout / runner 心跳
                              #   ghcr.io,*.pkg.github.com   镜像
                              #   playwright.azureedge.net   浏览器下载（若不用缓存）
                              #   （模型网关域名 —— 你的实际供应商）

# =============================================================================
# H. 通知与保留
# =============================================================================
NOTIFY_CHANNEL=               # [可选] slack webhook / 邮箱 / 留空=只看 GitHub
CI_ARTIFACT_RETENTION_DAYS=14 # [可选] 失败时的日志与截图
                              # ⚠ e2e 截图可能含测试数据，别设太长

# =============================================================================
# I. 我还需要你回答的三个问题（不是参数，是决定）
# =============================================================================
# Q1. 这台 VM 是**只跑 CI**，还是**同时当 staging 部署目标**？
#     同机的话 CI 的 DROP DATABASE 与 staging 数据只隔一个库名，我会额外加一道
#     「CI 库名必须带 CI_DB_PREFIX 前缀」的门控——这类事故一次就够了。
ANSWER_Q1=

# Q2. self-hosted runner 要不要接受 **fork 的 PR**？
#     默认**不接受**。self-hosted runner 跑的是 PR 里的代码：接受 fork 等于
#     任何人提个 PR 就能在你机器上执行任意命令。要接受的话必须加人工 approve 门。
ANSWER_Q2=no

# Q3. 后端门控要真 Docker + PG，比现在的 CI 重得多（现在只跑 turbo --affected）。
#     每个 PR 都跑，还是只在 main 与打标签时跑？
#     ⚠ 提醒一件事：`apps/api` 是刚加的，**现有 CI 从未跑过它的测试**——
#       `turbo run test --affected` 会命中 @repo/api，而那需要 Docker。
#       现在的 workflow 在 ubuntu-latest 上大概率会直接红。这不是新增需求，是**既有缺口**。
ANSWER_Q3=
