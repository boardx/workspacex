{
  "version": 5,
  "requiredChecks": [
    "verify-control-plane",
    "verify-affected",
    "verify-full-compile",
    "merge-gate",
    "backend-required",
    "queue-ready"
  ],
  "aggregates": {
    "queue-ready": [
      "verify-control-plane",
      "verify-affected",
      "verify-full-compile",
      "merge-gate",
      "backend-required"
    ]
  },
  "allowedMergeMethods": [
    "merge",
    "squash"
  ],
  "deferredChecks": [
    "visual-deferred"
  ],
  "independentChecks": [
    "native-board",
    "meeting-room"
  ],
  "sourceVerificationEvent": "merge_group",
  "mergeVerificationMode": "lightweight",
  "fullRegression": {
    "workflowPath": ".github/workflows/harness-acceptance.yml",
    "events": [
      "schedule",
      "workflow_dispatch"
    ],
    "cron": "17 * * * *",
    "coverage": "frozen-develop-snapshot-not-every-commit"
  }
}
