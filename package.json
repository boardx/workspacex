{
  "name": "agentic-harness-template",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "harness": "tsx .harness/scripts/cli.ts",
    "lint:ui-material": "node .harness/scripts/lint-ui-material.mjs",
    "lint:verification": "node .harness/scripts/lint-verification-can-fail.mjs",
    "lint:nav-reachability": "node .harness/scripts/lint-nav-reachability.mjs",
    "lint:third-artifact": "node .harness/scripts/lint-third-artifact.mjs",
    "verify:base": "pnpm run lint:ui-material && pnpm run lint:third-artifact && pnpm run lint:verification && pnpm run lint:nav-reachability && pnpm exec vitest run --dir .harness && turbo run typecheck lint test --continue",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "yaml": "^2.5.0",
    "@repo/coord-protocol": "workspace:*"
  }
}
