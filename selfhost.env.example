# 自托管 compose.yaml 所需的**必填**变量样例（复制为 selfhost.env 后改成真实值）。
# 本文件只列 include 进来的 compose 里用 `${VAR:?...}` 声明为必填的变量；
# 可选变量的默认值只在各 compose 文件里声明（单一事实源），这里不重复。
# 机械门 lint-self-host-compose.mjs 会核对：必填变量一个都不能漏。
MIGRATION_DB_PASSWORD=change-me-postgres-superuser-password
S3_ACCESS_KEY_ID=change-me-minio-user
S3_SECRET_ACCESS_KEY=change-me-minio-secret-at-least-8
SOURCE_REVISION=selfhost
SANDBOX_UID=1000
SANDBOX_GID=1000
SANDBOX_SOCKET_DIR=/var/lib/workspacex/sandbox
NATIVE_SESSION_SOCKET_DIR=/var/lib/workspacex/sessions
# 例外（不是必填、但经根 compose.yaml 起栈时必须设，#4263）：compose 不对 security_opt 做
# include 路径重定基，deploy compose 里的缺省相对路径会按仓库根解析到仓库外。此值相对仓库根。
WSX_SANDBOX_SECCOMP_PROFILE=./apps/skill-sandbox/security/docker-seccomp.json
