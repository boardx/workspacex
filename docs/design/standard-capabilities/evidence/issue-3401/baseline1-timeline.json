          "args": {
            "file_path": "/workspace/gen-capabilities.js",
            "content": "const { PDFDocument } = require('pdf-lib');\nconst fontkit = require('@pdf-lib/fontkit');\nconst fs = require('fs');\n\n(async () => {\n  const doc = await PDFDocument.create();\n  doc.registerFontkit(fontkit);\n  const fontBytes = fs.readFileSync('/usr/share/fonts/workspacex/NotoSansSC-Common.otf');\n  const font = await doc.embedFont(fontBytes);\n\n  const page = doc.addPage([595, 842]);\n  const W = 595, H = 842;\n  const LM = 50, RM = 50;\n  const usable = W - LM - RM;\n\n  let y = H - 60;\n\n  function drawTitle(text, size) {\n    page.drawText(text, { x: LM, y, size, font });\n    y -= size + 18;\n  }\n\n  function drawSection(text, size) {\n    y -= 6;\n    page.drawText(text, { x: LM, y, size, font });\n    y -= size + 10;\n    page.drawLine({ start: { x: LM, y }, end: { x: W - RM, y }, thickness: 0.8 });\n    y -= 14;\n  }\n\n  function drawBullet(text, size) {\n    const maxChars = Math.floor(usable / (size * 0.55));\n    const lines = [];\n    let remaining = text;\n    while (remaining.length > 0) {\n      if (remaining.length <= maxChars) { lines.push(remaining); break; }\n      lines.push(remaining.slice(0, maxChars));\n      remaining = remaining.slice(maxChars);\n    }\n    for (let i = 0; i < lines.length; i++) {\n      const prefix = i === 0 ? '• ' : '  ';\n      page.drawText(prefix + lines[i], { x: LM, y, size, font });\n      y -= size + 6;\n    }\n  }\n\n  // Title\n  drawTitle('AI 助手能力总结', 26);\n  y -= 4;\n  page.drawText('以下是我能够为您完成的主要任务与功能概览', { x: LM, y, size: 12, font });\n  y -= 24;\n\n  // Section 1\n  drawSection('一、文件创建与编辑', 16);\n  drawBullet('生成 PDF 文档：报告、说明手册、单页或多页排版文档', 11);\n  drawBullet('创建 Word (.docx) 文件：合同、信函、会议纪要等', 11);\n  drawBullet('制作 Excel (.xlsx) 表格：数据报表、清单、简单图表', 11);\n  drawBullet('制作 PowerPoint (.pptx) 演示文稿：幻灯片设计与内容填充', 11);\n  y -= 6;\n\n  // Section 2\n  drawSection('二、信息检索与分析', 16);\n  drawBullet('搜索并整理网络信息，提供结构化摘要', 11);\n  drawBullet('阅读和分析上传的文件（文本、图片、PDF 等）', 11);\n  drawBullet('数据解读、趋势分析与对比总结', 11);\n  y -= 6;\n\n  // Section 3\n  drawSection('三、编程与技术支持', 16);\n  drawBullet('编写、调试和优化多种语言的代码（Python、JS、SQL 等）', 11);\n  drawBullet('执行 Shell 命令与脚本，处理文件系统操作', 11);\n  drawBullet('解答技术问题，提供架构设计与最佳实践建议', 11);\n  y -= 6;\n\n  // Section 4\n  drawSection('四、写作与翻译', 16);\n  drawBullet('撰写各类文案：邮件、公告、营销文案、技术文档', 11);\n  drawBullet('中英文互译及多语言内容润色', 11);\n  drawBullet('文本改写、摘要提取与风格调整', 11);\n  y -= 6;\n\n  // Section 5\n  drawSection('五、任务规划与协作', 16);\n  drawBullet('将复杂需求拆解为可执行的步骤清单并逐步完成', 11);\n  drawBullet('在遇到歧义或缺少信息时主动确认，避免返工', 11);\n  drawBullet('提供多个可行方案供选择，附带投入与收益分析', 11);\n\n  // Footer note\n  y -= 20;\n  page.drawLine({ start: { x: LM, y }, end: { x: W - RM, y }, thickness: 0.5 });\n  y -= 16;\n  page.drawText('如需了解更多或有具体需求，请随时告诉我！', { x: LM, y, size: 10, font });\n\n  const bytes = await doc.save();\n  fs.writeFileSync('/workspace/capabilities-summary.pdf', bytes);\n  console.log('PDF generated successfully.');\n})().catch((e) => { console.error(e.stack); process.exit(1); });\n"
          }
        }
