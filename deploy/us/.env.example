# 必填：五个正式镜像中实际存在的同一版本。不是 latest，也不要原样填写占位值。
IMAGE_TAG=REPLACE_IMAGE_TAG
# 真实公网域名，不带 https:// 或路径；A记录指向这台US服务器。
PUBLIC_DOMAIN=REPLACE_PUBLIC_DOMAIN
ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
# 模型服务，不要把真实 .env 提交到Git或发送到聊天。
MODEL_BASE_URL=REPLACE_HTTPS_MODEL_BASE_URL
MODEL_ID=REPLACE_MODEL_ID
MODEL_API_KEY=REPLACE_MODEL_API_KEY
# 以下通常不用改。
REGISTRY_PREFIX=workspacex-cn-prod-registry.cn-shanghai.cr.aliyuncs.com/workspacex-prod
REDIS_IMAGE=redis:7-alpine
ADMIN_NAME=Administrator
ORG_NAME=Workspace
