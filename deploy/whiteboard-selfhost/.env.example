# Pin released images by digest; floating tags make rollback and evidence unreliable.
WORKSPACEX_API_IMAGE=ghcr.io/boardx/workspacex-api@sha256:REPLACE_ME
WORKSPACEX_WEB_IMAGE=ghcr.io/boardx/workspacex-web@sha256:REPLACE_ME
PGDATABASE=workspacex
MIGRATION_DB_PASSWORD=REPLACE_WITH_32_RANDOM_CHARACTERS
MIGRATION_DB_USER=postgres
APP_DB_USER=app_rw
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_32_RANDOM_CHARACTERS
DIAG_DB_USER=app_diag_ro
DIAG_DB_PASSWORD=REPLACE_WITH_DIFFERENT_32_RANDOM_CHARACTERS
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_32_RANDOM_CHARACTERS
REDIS_PREFIX=wsx:board:
PGSSLMODE=disable
HTTP_PORT=8080

